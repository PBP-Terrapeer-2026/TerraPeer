# Copy to .env for local development. Never commit the real .env.
# Production (PWS) sets these in the PWS dashboard → Environs.

# Development: leave PRODUCTION unset or false → DEBUG on, SQLite (db.sqlite3).
# Production: PRODUCTION=true → DEBUG off, PostgreSQL from the DB_* values below.
PRODUCTION=false

# Required when PRODUCTION=true (the site refuses to start without it).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# PostgreSQL, only read when PRODUCTION=true
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
SCHEMA=public

# Perenual plant data (My Plants species lookup, Garden Planning recommendations).
# Optional: without it, species can be typed in and Planning shows built-in suggestions.
PERENUAL_API_KEY=

# Optional: full Perenual species-list URL used by Garden Planning instead of the default.
API_URL=

# Optional: Plant Care sample weather instead of live Open-Meteo data (1 = on).
WEATHER_DEMO=0
